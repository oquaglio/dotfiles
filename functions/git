# Git branch hygiene.
#
# Commands:
#   gitstale       list local branches whose upstream is gone or that are merged
#                  into the default branch (read-only — safe to run anywhere)
#   gitprune       same scan but interactively delete each branch (y/N prompt).
#                  Prints the SHA of every deleted branch so recovery is
#                  `git branch <name> <sha>`.
#
# Both run `git fetch --prune` first to ensure remote state is current.

# Internal: detect the default branch (origin/HEAD → main/master/whatever).
_git_default_branch() {
    local b
    b=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
        | sed 's@^refs/remotes/origin/@@')
    if [ -z "$b" ]; then
        # Fallback: pick whichever of main/master exists locally.
        if git show-ref --verify --quiet refs/heads/main; then
            b=main
        elif git show-ref --verify --quiet refs/heads/master; then
            b=master
        fi
    fi
    echo "$b"
}

# Internal: emit the list of stale-branch candidates, one per line, deduped.
_git_stale_candidates() {
    local default current
    default=$(_git_default_branch)
    current=$(git symbolic-ref --short HEAD 2>/dev/null)

    {
        # Branches whose tracked remote is gone.
        git branch -vv 2>/dev/null | awk '/: gone\]/ { print $1 }' | sed 's/^\*//'

        # Branches already merged into the default branch.
        if [ -n "$default" ]; then
            git branch --merged "$default" 2>/dev/null \
                | sed 's/^[* ]*//' \
                | grep -vE "^(${default}|main|master)$"
        fi
    } \
    | sort -u \
    | grep -vxF -- "$current" \
    || true
}

gitstale() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Not inside a git repo." >&2
        return 1
    fi

    local default
    default=$(_git_default_branch)
    : "${default:?Could not detect default branch}"

    echo "Fetching (with --prune)..."
    git fetch --prune --quiet

    echo
    echo "=== Local branches whose upstream is gone ==="
    git branch -vv | awk '/: gone\]/ { print "  " $0 }' || echo "  (none)"

    echo
    echo "=== Local branches merged into $default ==="
    local merged
    merged=$(git branch --merged "$default" 2>/dev/null \
        | sed 's/^[* ]*//' \
        | grep -vE "^(${default}|main|master)$" || true)
    if [ -z "$merged" ]; then
        echo "  (none)"
    else
        echo "$merged" | sed 's/^/  /'
    fi

    echo
    echo "(run \`gitprune\` to interactively delete)"
}

gitprune() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Not inside a git repo." >&2
        return 1
    fi

    git fetch --prune --quiet

    local candidates
    candidates=$(_git_stale_candidates)

    if [ -z "$candidates" ]; then
        echo "No stale branches."
        return 0
    fi

    echo "$candidates" | while IFS= read -r branch; do
        [ -z "$branch" ] && continue
        local sha
        sha=$(git rev-parse --short "$branch" 2>/dev/null) || continue
        printf 'Delete %s (%s)? [y/N] ' "$branch" "$sha"
        read -r reply
        case "$reply" in
            [yY]*)
                if git branch -D -- "$branch" >/dev/null 2>&1; then
                    printf '  → deleted (recover with: git branch %s %s)\n' "$branch" "$sha"
                else
                    echo '  → delete failed'
                fi
                ;;
            *)
                echo '  → kept'
                ;;
        esac
    done
}

# Fzf-powered git selectors.
#
#   fbr            checkout a local branch (preview: recent commits on it)
#   gco            checkout any ref: local branches + remote branches + tags
#   fadd           multi-select staging via TAB; preview shows diff per file

fbr() {
    local branch
    branch=$(command git --no-pager branch --color=never \
        | grep -v '^\*' \
        | sed 's/^ *//' \
        | fzf --preview 'git log --oneline --color=always --decorate -20 {} 2>/dev/null') \
        || return
    [ -n "$branch" ] && command git checkout "$branch"
}

gco() {
    local target
    target=$( {
        command git --no-pager branch --all --color=never \
            | grep -v 'HEAD' \
            | sed 's|^[* ]*||;s|^remotes/||'
        command git --no-pager tag --color=never
    } | sort -u \
      | fzf --header='git checkout' \
            --preview 'git log --oneline --color=always --decorate -20 {} 2>/dev/null') \
      || return
    [ -n "$target" ] && command git checkout "$target"
}

fadd() {
    local files
    files=$(command git -c color.status=always status -s \
        | fzf -m --ansi --nth=2.. \
              --preview 'f=$(echo {} | awk "{print \$NF}"); git diff --color=always -- "$f" | head -200' \
        | awk '{print $NF}')
    if [ -n "$files" ]; then
        echo "$files" | xargs -r command git add
        command git status -s
    fi
}

###############################################################################
# gitinfo — one-screen situational report for the repository at $PWD.
#
# Usage:
#   gitinfo          report on the repo containing $PWD
#   gitinfo -f       `git fetch --prune` first, so ahead/behind reflects the
#                    actual remote rather than your last fetch
#   gitinfo -a       don't cap long branch/tag/commit lists
#
# Read-only and offline by default: without -f it never touches the network,
# so ahead/behind is only as fresh as your last fetch. The Sync section prints
# that age and warns when it has gone stale.
#
# Credentials embedded in remote URLs are masked in the output and called out
# as a finding — they sit in plaintext in .git/config.
#
# Alias: ginfo
###############################################################################

# Internal: colours, suppressed when not on a terminal or when NO_COLOR is set,
# so `gitinfo > report.txt` stays readable.
_gitinfo_colours() {
    if [ -t 1 ] && [ -z "$NO_COLOR" ]; then
        _gi_hdr=$'\033[1;36m'; _gi_dim=$'\033[2m';  _gi_warn=$'\033[1;33m'
        _gi_bad=$'\033[1;31m'; _gi_ok=$'\033[1;32m'; _gi_nc=$'\033[0m'
    else
        _gi_hdr=''; _gi_dim=''; _gi_warn=''; _gi_bad=''; _gi_ok=''; _gi_nc=''
    fi
}

# Internal: section header, with the command(s) behind it shown dimmed.
_gitinfo_h() {
    printf '\n%s== %s%s' "$_gi_hdr" "$1" "$_gi_nc"
    [ -n "$2" ] && printf '  %s[%s]%s' "$_gi_dim" "$2" "$_gi_nc"
    printf '\n'
}

# Internal: "key: value" row with a dim key.
_gitinfo_kv() {
    printf '  %s%-14s%s %s\n' "$_gi_dim" "$1" "$_gi_nc" "$2"
}

# Internal: hide any user:password@ / token@ embedded in a remote URL.
_gitinfo_mask_url() {
    printf '%s\n' "$1" | sed -E 's#(://)[^/@]+@#\1***@#'
}

# Internal: cap a list, appending a "N more" note. $1 = limit (0 = unlimited).
_gitinfo_cap() {
    local limit="$1" total shown
    if [ "$limit" -le 0 ]; then cat; return; fi
    total=$(cat); [ -z "$total" ] && return
    shown=$(printf '%s\n' "$total" | head -n "$limit")
    printf '%s\n' "$shown"
    local n
    n=$(printf '%s\n' "$total" | wc -l)
    [ "$n" -gt "$limit" ] && printf '  %s… %d more%s\n' "$_gi_dim" "$((n - limit))" "$_gi_nc"
    return 0
}

gitinfo() {
    local do_fetch=0 cap=10 arg
    for arg in "$@"; do
        case "$arg" in
            -f | --fetch) do_fetch=1 ;;
            -a | --all)   cap=0 ;;
            -h | --help)
                printf 'usage: gitinfo [-f|--fetch] [-a|--all]\n'
                printf '  -f  git fetch --prune first (network)\n'
                printf '  -a  do not cap long lists\n'
                return 0 ;;
            *) printf 'gitinfo: unknown option %s\n' "$arg" >&2; return 2 ;;
        esac
    done

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Not inside a git repo." >&2
        return 1
    fi

    local _gi_hdr _gi_dim _gi_warn _gi_bad _gi_ok _gi_nc
    _gitinfo_colours

    local root git_dir head_branch default_branch upstream
    root=$(git rev-parse --show-toplevel 2>/dev/null)
    git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null || git rev-parse --git-dir 2>/dev/null)
    head_branch=$(git symbolic-ref --short HEAD 2>/dev/null)
    default_branch=$(_git_default_branch)
    # An unborn HEAD (freshly `git init`ed) makes every log/rev-list call fail.
    local has_commits=""
    git rev-parse --verify --quiet HEAD >/dev/null 2>&1 && has_commits=1

    if [ "$do_fetch" = 1 ]; then
        printf '%sFetching (--prune)...%s\n' "$_gi_dim" "$_gi_nc"
        git fetch --prune --quiet || printf '%s  fetch failed — showing cached state%s\n' "$_gi_warn" "$_gi_nc"
    fi

    # --- Repository ----------------------------------------------------------
    _gitinfo_h "Repository" "git rev-parse / count-objects"
    _gitinfo_kv "root" "$root"
    _gitinfo_kv "git dir" "$git_dir"
    _gitinfo_kv "default" "${default_branch:-${_gi_warn}unknown${_gi_nc}}"
    # Report loose and packed separately: size-pack alone reads "0 bytes" on a
    # repo that has never been gc'd, which looks like a broken repo.
    local co_out size_pack size_loose n_loose
    co_out=$(git count-objects -vH 2>/dev/null)
    size_pack=$(printf '%s\n' "$co_out" | awk -F': ' '/^size-pack/ {print $2}')
    size_loose=$(printf '%s\n' "$co_out" | awk -F': ' '/^size:/ {print $2}')
    n_loose=$(printf '%s\n' "$co_out" | awk -F': ' '/^count:/ {print $2}')
    [ -n "$size_pack" ] && _gitinfo_kv "packed" "$size_pack"
    if [ "${n_loose:-0}" -gt 0 ]; then
        _gitinfo_kv "loose" "$size_loose in ${n_loose} objects${_gi_dim} (git gc to pack)${_gi_nc}"
    fi

    # Identity, flagged when it comes from repo-local config rather than global.
    local uname uemail uscope
    uname=$(git config user.name 2>/dev/null)
    uemail=$(git config user.email 2>/dev/null)
    if git config --local user.email >/dev/null 2>&1; then
        uscope=" ${_gi_dim}(repo-local override)${_gi_nc}"
    else
        uscope=""
    fi
    if [ -n "$uemail" ]; then
        _gitinfo_kv "identity" "${uname} <${uemail}>${uscope}"
    else
        _gitinfo_kv "identity" "${_gi_bad}unset — commits will fail${_gi_nc}"
    fi

    # --- In-progress operation ----------------------------------------------
    # Printed early: if a rebase is half-done, that's the headline.
    local op=""
    [ -d "$git_dir/rebase-merge" ] && op="rebase (interactive/merge)"
    [ -d "$git_dir/rebase-apply" ] && op="rebase (am)"
    [ -f "$git_dir/MERGE_HEAD" ] && op="merge"
    [ -f "$git_dir/CHERRY_PICK_HEAD" ] && op="cherry-pick"
    [ -f "$git_dir/REVERT_HEAD" ] && op="revert"
    [ -f "$git_dir/BISECT_LOG" ] && op="bisect"
    if [ -n "$op" ]; then
        _gitinfo_h "In progress"
        printf '  %s%s in progress%s — finish with --continue or --abort\n' "$_gi_warn" "$op" "$_gi_nc"
    fi

    # --- HEAD ----------------------------------------------------------------
    _gitinfo_h "HEAD" "git symbolic-ref / log -1"
    if [ -n "$head_branch" ]; then
        _gitinfo_kv "branch" "$head_branch"
    else
        _gitinfo_kv "branch" "${_gi_warn}detached${_gi_nc} at $(git describe --all --always HEAD 2>/dev/null)"
    fi
    upstream=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)
    if [ -n "$upstream" ]; then
        _gitinfo_kv "upstream" "$upstream"
    elif [ -n "$head_branch" ]; then
        _gitinfo_kv "upstream" "${_gi_warn}none — push with -u to set one${_gi_nc}"
    fi
    if [ -n "$has_commits" ]; then
        _gitinfo_kv "last commit" "$(git log -1 --format='%h %s' 2>/dev/null)"
        _gitinfo_kv "" "$(git log -1 --format='%an, %ar' 2>/dev/null)"
    else
        _gitinfo_kv "last commit" "${_gi_dim}(no commits yet)${_gi_nc}"
    fi

    # --- Working tree --------------------------------------------------------
    _gitinfo_h "Working tree" "git status --porcelain"
    local st staged modified untracked conflicts
    st=$(git status --porcelain=v1 2>/dev/null)
    staged=$(printf '%s\n' "$st"   | grep -c '^[MADRC]' || true)
    modified=$(printf '%s\n' "$st" | grep -c '^.[MD]' || true)
    untracked=$(printf '%s\n' "$st" | grep -c '^??' || true)
    conflicts=$(printf '%s\n' "$st" | grep -cE '^(DD|AU|UD|UA|DU|AA|UU)' || true)
    if [ -z "$st" ]; then
        printf '  %sclean%s\n' "$_gi_ok" "$_gi_nc"
    else
        _gitinfo_kv "staged" "$staged"
        _gitinfo_kv "modified" "$modified"
        _gitinfo_kv "untracked" "$untracked"
        [ "$conflicts" -gt 0 ] && _gitinfo_kv "conflicts" "${_gi_bad}${conflicts}${_gi_nc}"
    fi

    # --- Remotes -------------------------------------------------------------
    _gitinfo_h "Remotes" "git remote -v"
    local remotes has_creds=0
    remotes=$(git remote 2>/dev/null)
    if [ -z "$remotes" ]; then
        printf '  %s(none — nothing to push to)%s\n' "$_gi_warn" "$_gi_nc"
    else
        local r furl purl
        while IFS= read -r r; do
            [ -z "$r" ] && continue
            furl=$(git remote get-url "$r" 2>/dev/null)
            purl=$(git remote get-url --push "$r" 2>/dev/null)
            case "$furl" in *://*@*) has_creds=1 ;; esac
            _gitinfo_kv "$r" "$(_gitinfo_mask_url "$furl")"
            [ "$purl" != "$furl" ] && _gitinfo_kv "" "push: $(_gitinfo_mask_url "$purl")"
        done <<EOF
$remotes
EOF
        [ "$has_creds" = 1 ] && printf '  %s! credentials embedded in a remote URL — stored in plaintext in %s/config%s\n' \
            "$_gi_bad" "$git_dir" "$_gi_nc"
    fi

    # --- Sync ----------------------------------------------------------------
    _gitinfo_h "Sync" "git rev-list --count"
    if [ -f "$git_dir/FETCH_HEAD" ]; then
        local fetch_age
        fetch_age=$(( ( $(date +%s) - $(date -r "$git_dir/FETCH_HEAD" +%s) ) / 3600 ))
        if [ "$fetch_age" -ge 24 ]; then
            _gitinfo_kv "last fetch" "${_gi_warn}$((fetch_age / 24))d ago — counts below may be stale, run \`gitinfo -f\`${_gi_nc}"
        else
            _gitinfo_kv "last fetch" "${fetch_age}h ago"
        fi
    else
        _gitinfo_kv "last fetch" "${_gi_warn}never — run \`gitinfo -f\`${_gi_nc}"
    fi

    if [ -n "$upstream" ]; then
        local ahead behind
        ahead=$(git rev-list --count "$upstream..HEAD" 2>/dev/null)
        behind=$(git rev-list --count "HEAD..$upstream" 2>/dev/null)
        if [ "${ahead:-0}" -gt 0 ] || [ "${behind:-0}" -gt 0 ]; then
            _gitinfo_kv "vs upstream" "${_gi_warn}${ahead} ahead, ${behind} behind${_gi_nc}"
            [ "${ahead:-0}" -gt 0 ] && [ "${behind:-0}" -gt 0 ] && \
                printf '  %sdiverged — pull --rebase before pushing%s\n' "$_gi_warn" "$_gi_nc"
        else
            _gitinfo_kv "vs upstream" "${_gi_ok}in sync${_gi_nc}"
        fi
    fi

    # Commits on any local branch that exist on no remote at all — work that
    # would be lost if this machine died.
    if [ -n "$remotes" ]; then
        local unpushed
        unpushed=$(git rev-list --count --branches --not --remotes 2>/dev/null)
        if [ "${unpushed:-0}" -gt 0 ]; then
            _gitinfo_kv "unpushed" "${_gi_warn}${unpushed} commit(s) on no remote${_gi_nc}"
            git log --branches --not --remotes --format="    %h %s ${_gi_dim}(%an, %ar)${_gi_nc}" 2>/dev/null \
                | _gitinfo_cap "$cap"
        else
            _gitinfo_kv "unpushed" "${_gi_ok}none${_gi_nc}"
        fi
    fi

    # --- Local branches ------------------------------------------------------
    _gitinfo_h "Local branches" "git for-each-ref refs/heads"
    local nlocal
    nlocal=$(git for-each-ref --format='%(refname)' refs/heads 2>/dev/null | wc -l)
    printf '  %s%d total%s\n' "$_gi_dim" "$nlocal" "$_gi_nc"
    git for-each-ref \
        --sort=-committerdate \
        --format='%(if)%(HEAD)%(then)*%(else) %(end) %(refname:short)|%(upstream:short)|%(upstream:track)|%(committerdate:relative)' \
        refs/heads 2>/dev/null \
    | awk -F'|' -v w="$_gi_warn" -v d="$_gi_dim" -v n="$_gi_nc" '{
        track = $3
        if (track == "[gone]")      track = w "upstream gone" n
        else if (track == "")       track = (($2 == "") ? w "no upstream" n : "")
        else                        { gsub(/[\[\]]/, "", track); track = w track n }
        printf "  %-28s %-26s %s%s%s  %s\n", $1, $2, d, $4, n, track
    }' | sed 's/[[:space:]]*$//' | _gitinfo_cap "$cap"

    # --- Remote branches -----------------------------------------------------
    if [ -n "$remotes" ]; then
        _gitinfo_h "Remote branches" "git for-each-ref refs/remotes"
        # Filter on the full refname: refs/remotes/origin/HEAD shortens to a
        # bare "origin", so testing the short name for HEAD never matches it.
        # creatordate (not committerdate) so tag objects still report a date.
        local remote_refs
        remote_refs=$(git for-each-ref --sort=-creatordate \
            --format='%(refname)|%(refname:short)|%(creatordate:relative)|%(authorname)' \
            refs/remotes 2>/dev/null | grep -v '^refs/remotes/[^|]*/HEAD|')
        local nremote=0
        [ -n "$remote_refs" ] && nremote=$(printf '%s\n' "$remote_refs" | wc -l)
        printf '  %s%d total%s\n' "$_gi_dim" "$nremote" "$_gi_nc"
        printf '%s\n' "$remote_refs" \
        | awk -F'|' -v d="$_gi_dim" -v n="$_gi_nc" 'NF { printf "  %-40s %s%s%s%s\n", $2, d, $3, ($4 == "" ? "" : ", " $4), n }' \
        | _gitinfo_cap "$cap"

        # Remote-tracking refs with no local branch — things you could check out.
        local untracked_remotes
        untracked_remotes=$(
            printf '%s\n' "$remote_refs" \
            | awk -F'|' 'NF { print $2 }' | sed 's#^[^/]*/##' | sort -u \
            | grep -vxF -f <(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null) 2>/dev/null
        )
        if [ -n "$untracked_remotes" ]; then
            printf '  %snot checked out locally:%s\n' "$_gi_dim" "$_gi_nc"
            printf '%s\n' "$untracked_remotes" | sed 's/^/    /' | _gitinfo_cap "$cap"
        fi
    fi

    # --- Stashes -------------------------------------------------------------
    local nstash
    nstash=$(git stash list 2>/dev/null | wc -l)
    if [ "$nstash" -gt 0 ]; then
        _gitinfo_h "Stashes" "git stash list"
        printf '  %s%d total%s\n' "$_gi_dim" "$nstash" "$_gi_nc"
        git stash list --format='  %gd %s %cr' 2>/dev/null | _gitinfo_cap "$cap"
    fi

    # --- Tags ----------------------------------------------------------------
    local ntags
    ntags=$(git tag 2>/dev/null | wc -l)
    if [ "$ntags" -gt 0 ]; then
        _gitinfo_h "Tags" "git tag / describe"
        _gitinfo_kv "count" "$ntags"
        _gitinfo_kv "latest" "$(git describe --tags --abbrev=0 2>/dev/null || echo 'n/a')"
        _gitinfo_kv "since tag" "$(git describe --tags 2>/dev/null || echo 'n/a')"
    fi

    # --- Submodules ----------------------------------------------------------
    if [ -f "$root/.gitmodules" ]; then
        _gitinfo_h "Submodules" "git submodule status"
        git submodule status 2>/dev/null | sed 's/^/  /' | _gitinfo_cap "$cap"
    fi

    # --- Worktrees -----------------------------------------------------------
    local nwt
    nwt=$(git worktree list 2>/dev/null | wc -l)
    if [ "$nwt" -gt 1 ]; then
        _gitinfo_h "Worktrees" "git worktree list"
        git worktree list 2>/dev/null | sed 's/^/  /'
    fi

    # --- Hooks ---------------------------------------------------------------
    # Only non-.sample hooks: these are executable code git runs on your behalf,
    # and they arrive with any repo you clone.
    local hooks
    hooks=$(find "$git_dir/hooks" -maxdepth 1 -type f ! -name '*.sample' -printf '%f\n' 2>/dev/null | sort)
    if [ -n "$hooks" ]; then
        _gitinfo_h "Hooks" "$git_dir/hooks"
        printf '%s\n' "$hooks" | sed 's/^/  /'
    fi

    # --- Recent commits ------------------------------------------------------
    if [ -n "$has_commits" ]; then
        _gitinfo_h "Recent commits" "git log"
        git log --format='  %h %s' -5 2>/dev/null
    fi

    printf '\n'
}
