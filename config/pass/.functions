# Secrets to manage - edit this list
_PASS_SECRETS=(
    "aws/access-key-id:AWS_ACCESS_KEY_ID"
    "aws/secret-access-key:AWS_SECRET_ACCESS_KEY"
    "snowflake/password:SNOWFLAKE_PASSWORD"
    "github/token:GITHUB_TOKEN"
)

load_secrets() {
    local set_vars=()
    local missing=()

    for entry in "${_PASS_SECRETS[@]}"; do
        local pass_path="${entry%%:*}"
        local env_var="${entry##*:}"

        if pass show "$pass_path" &>/dev/null; then
            export "$env_var"="$(pass show "$pass_path" 2>/dev/null)"
            set_vars+=("$env_var")
        else
            missing+=("$pass_path → $env_var")
        fi
    done

    if [[ ${#set_vars[@]} -gt 0 ]]; then
        echo "✓ Loaded:"
        for v in "${set_vars[@]}"; do echo "    $v"; done
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "✗ Not found in pass (not set):"
        for m in "${missing[@]}"; do echo "    $m"; done
    fi
}

remove_secrets() {
    local unset_vars=()
    local already_unset=()

    for entry in "${_PASS_SECRETS[@]}"; do
        local env_var="${entry##*:}"

        if [[ -n "${(P)env_var}" ]]; then
            unset "$env_var"
            unset_vars+=("$env_var")
        else
            already_unset+=("$env_var")
        fi
    done

    if [[ ${#unset_vars[@]} -gt 0 ]]; then
        echo "✓ Unset:"
        for v in "${unset_vars[@]}"; do echo "    $v"; done
    fi

    if [[ ${#already_unset[@]} -gt 0 ]]; then
        echo "- Already unset:"
        for v in "${already_unset[@]}"; do echo "    $v"; done
    fi
}

# Helpers for the GPG-backed `pass` password store.
#
# Assumes the conventional multi-line entry format:
#   <secret>            <- first line is the password/secret
#   username: otto      <- remaining lines are "key: value" fields
#   url: https://...
#
# Commands:
#   pass_secret PATH        print the secret (first line) of PATH.
#   pass_field  PATH KEY    print the value of field KEY in PATH. Key match is
#                           case-insensitive; returns 1 if KEY isn't present.
#
# Examples:
#   export DB_PASS=$(pass_secret work/db)
#   pass_field work/db username

pass_secret() {
    if [ $# -ne 1 ]; then
        echo "usage: pass_secret PATH" >&2
        return 2
    fi
    command -v pass >/dev/null 2>&1 || { echo "pass_secret: pass not installed" >&2; return 127; }

    local out
    out=$(pass show "$1") || return $?
    printf '%s\n' "${out%%$'\n'*}"
}

pass_field() {
    if [ $# -ne 2 ]; then
        echo "usage: pass_field PATH KEY" >&2
        return 2
    fi
    command -v pass >/dev/null 2>&1 || { echo "pass_field: pass not installed" >&2; return 127; }

    local out
    out=$(pass show "$1") || return $?
    printf '%s\n' "$out" | awk -v key="$2" '
        NR == 1 { next }
        {
            i = index($0, ":")
            if (i == 0) next
            k = substr($0, 1, i - 1)
            gsub(/^[ \t]+|[ \t]+$/, "", k)
            if (tolower(k) == tolower(key)) {
                v = substr($0, i + 1)
                sub(/^[ \t]+/, "", v)
                print v
                found = 1
                exit
            }
        }
        END { exit !found }
    ' || { echo "pass_field: no field \"$2\" in $1" >&2; return 1; }
}
